# AI System Platform - 环境变量
# 复制此文件为 .env 并根据实际环境修改

# 应用
APP_NAME=AI System Platform
APP_VERSION=1.0.0
ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-a-random-string

# 数据库
DATABASE_URL=mysql+aiomysql://aisys:aisys123@localhost:3306/ai_platform

# Redis
REDIS_URL=redis://:aisys_redis_2024@localhost:6379/0

# RabbitMQ
RABBITMQ_URL=amqp://aisys:aisys123@localhost:5672/ai_platform

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530

# LLM (OpenAI 兼容接口)
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# JWT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# 文件上传
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads
